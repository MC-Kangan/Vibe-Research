# Copy to `.env` beside compose.yaml. `.env` is ignored by Git.

# Local proof defaults: the application is reachable only from this machine.
VR_BIND_ADDRESS=127.0.0.1
VR_WEB_PORT=8080
VR_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Leave blank for the local deployment proof. This shared key is not the future
# Tailscale human-authentication layer.
VR_API_KEY=

# Human login for the NAS deployment. Generate the hash with the command in
# backend/.env.example; do not put the plaintext password in this file.
VR_AUTH_ENABLED=true
VR_AUTH_USERNAME=admin
VR_AUTH_PASSWORD_HASH=
VR_SESSION_SECRET=
VR_SESSION_TTL_HOURS=12
VR_AUTH_COOKIE_SECURE=true

# Optional market intelligence providers. Keep keys server-side.
VR_FINNHUB_API_KEY=
VR_SEC_USER_AGENT=VibeResearch/0.3 your-email@example.com

# Optional TradeAgent skills bridge. Build/tag the sibling TradeAgent image as
# trade-research:latest, then start Compose with the `research` profile.
VR_TRADE_RESEARCH_ENABLED=false
VR_TRADE_RESEARCH_API_TOKEN=
TRADE_RESEARCH_IMAGE=trade-research:latest
TRADE_RESEARCH_PRICE_PROVIDER=yahoo

# Read-only IBKR Flex current-position import. Keep these values server-side.
VR_IBKR_FLEX_TOKEN=
VR_IBKR_FLEX_QUERY_ID=
VR_IBKR_FLEX_HISTORY_QUERY_ID=
VR_IBKR_FLEX_TIMEZONE=Europe/London
VR_IBKR_FLEX_COOLDOWN_SECONDS=300
VR_IBKR_FLEX_TIMEOUT_SECONDS=20
VR_IBKR_FLEX_REQUEST_RETRIES=1
VR_IBKR_FLEX_RETRIES=3
VR_IBKR_FLEX_RETRY_DELAY_SECONDS=5
VR_IBKR_FLEX_INTER_QUERY_DELAY_SECONDS=5
VR_IBKR_ANALYTICS_STORE=/data/ibkr-analytics.sqlite3

# Omit this variable to use the Docker-managed `vibe-data` volume.
# On the NAS, use an absolute directory whose owner is uid/gid 10001.
# VR_DATA_PATH=/volume1/docker/vibe-research/data
