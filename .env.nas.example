# Copy this file to `.env.nas`, fill every REQUIRED value, and keep it private.

# Repositories. Keep TradeAgent beside VibeResearch, or set its absolute path.
TRADE_AGENT_PATH=../TradeAgent

# Image names built on the Mac and imported into the NAS Docker app.
VIBE_FRONTEND_IMAGE=vibe-research-frontend:nas-amd64
VIBE_BACKEND_IMAGE=vibe-research-backend:nas-amd64
TRADE_RESEARCH_IMAGE=trade-research:nas-amd64

# REQUIRED: resolve and review the current Python base-image digest before deployment.
# Example shape only; do not paste this placeholder unchanged.
PYTHON_BASE_IMAGE=python:3.12-slim@sha256:REPLACE_WITH_APPROVED_DIGEST

# Tailscale. Use a non-ephemeral, pre-authorized auth key for first enrollment.
# After the persisted node survives a restart, revoke the key and leave this blank.
TS_AUTHKEY=
TS_HOSTNAME=vibe-research
TAILSCALE_IMAGE=tailscale/tailscale:latest

# REQUIRED: exact HTTPS URL produced for TS_HOSTNAME in your tailnet.
VR_PUBLIC_ORIGIN=https://vibe-research.your-tailnet.ts.net

# Browser login. Generate the Argon2id value with the command in the NAS guide.
VR_AUTH_USERNAME=admin
VR_AUTH_PASSWORD_HASH='$argon2id$REPLACE_WITH_GENERATED_HASH'
VR_SESSION_TTL_HOURS=12

# Shared internal Vibe -> TradeAgent bearer token. Keep this file private.
TRADE_RESEARCH_API_TOKEN=REPLACE_WITH_GENERATED_TOKEN
VR_TRADE_RESEARCH_TIMEOUT_SECONDS=30

# Public provider defaults used by TradeAgent.
TRADE_RESEARCH_PRICE_PROVIDER=yahoo
TRADE_RESEARCH_FUNDAMENTAL_PROVIDER=sec_company_facts
VR_SEC_USER_AGENT=VibeResearch/0.3 your-email@example.com

# Optional server-side AI configuration. The key stays in the backend container
# and is never sent to the browser. The model value is passed to the provider as-is.
VR_LLM_PROVIDER=deepseek
VR_LLM_BASE_URL=https://api.deepseek.com
VR_LLM_API_KEY=
VR_LLM_MODEL=deepseek-v4-flash

# Optional Vibe data-provider credentials.
VR_API_KEY=
VR_FINNHUB_API_KEY=
VR_COINGECKO_API_KEY=
VR_COINGECKO_API_TIER=demo
VR_COINBASE_API_KEY_NAME=
VR_COINBASE_API_PRIVATE_KEY=
VR_COINBASE_API_ALGORITHM=ES256

# Optional read-only IBKR Flex import.
VR_IBKR_FLEX_TOKEN=
VR_IBKR_FLEX_QUERY_ID=
VR_IBKR_FLEX_HISTORY_QUERY_ID=
VR_IBKR_FLEX_TIMEZONE=Europe/London
VR_IBKR_FLEX_COOLDOWN_SECONDS=300
VR_IBKR_FLEX_TIMEOUT_SECONDS=20
VR_IBKR_FLEX_REQUEST_RETRIES=1
VR_IBKR_FLEX_RETRIES=3
VR_IBKR_FLEX_RETRY_DELAY_SECONDS=5
VR_IBKR_FLEX_INTER_QUERY_DELAY_SECONDS=5
