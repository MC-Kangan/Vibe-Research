# VibeResearch 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 本地开发请先 export 这些环境变量再起服务；Docker Compose 部署使用仓库根目录的 .env。

# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   VR_ALLOW_ORIGINS=https://your-frontend-host
VR_ALLOW_ORIGINS=*

# 鉴权 key。一旦设置，所有 /api/*（除 /api/health）都需带 Authorization: Bearer <key>。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   VR_API_KEY=$(openssl rand -hex 32)
VR_API_KEY=

# Optional browser login for NAS/Tailscale deployments. Keep disabled locally.
# Generate a password hash with: python -c 'import getpass; from auth import hash_password; print(hash_password(getpass.getpass()))'
# VR_AUTH_ENABLED=false
# VR_AUTH_USERNAME=admin
# VR_AUTH_PASSWORD_HASH=
# VR_SESSION_SECRET=
# VR_SESSION_TTL_HOURS=12
# VR_AUTH_COOKIE_SECURE=true

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅 iwencai 语义搜索研报需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# 美股/欧洲公司新闻与历史 earnings（可选 free trial）：
# VR_FINNHUB_API_KEY=

# SEC EDGAR 无需 key，但官方要求请求标明可联系的 User-Agent。建议填真实邮箱：
# VR_SEC_USER_AGENT=VibeResearch/0.3 your-email@example.com

# Optional deterministic skills analysis via TradeAgent (read-only; no portfolio/IBKR access).
# VR_TRADE_RESEARCH_ENABLED=false
# VR_TRADE_RESEARCH_BASE_URL=http://127.0.0.1:8000
# VR_TRADE_RESEARCH_API_TOKEN=
# VR_TRADE_RESEARCH_TIMEOUT_SECONDS=30

# Direct read-only IBKR current-position import and local analytics.
# VR_IBKR_FLEX_TOKEN=
# VR_IBKR_FLEX_QUERY_ID=
# VR_IBKR_FLEX_HISTORY_QUERY_ID=
# VR_IBKR_FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
# VR_IBKR_FLEX_TIMEZONE=Europe/London
# VR_IBKR_FLEX_COOLDOWN_SECONDS=300
# VR_IBKR_FLEX_TIMEOUT_SECONDS=20
# VR_IBKR_FLEX_REQUEST_RETRIES=1
# VR_IBKR_FLEX_RETRIES=3
# VR_IBKR_FLEX_RETRY_DELAY_SECONDS=5
# VR_IBKR_POSITION_STORE=~/.vibe-research/ibkr-positions.json
# VR_IBKR_FLEX_INTER_QUERY_DELAY_SECONDS=5
# VR_IBKR_ANALYTICS_STORE=~/.vibe-research/ibkr-analytics.sqlite3

# 代理：默认不用管。东财等国内数据源**默认直连**（自动绕开你的科学上网/Clash 代理，
# 因为国内财经站走翻墙代理反而会连不上，如 push2.eastmoney.com）。
# 仅当你的机器「只能靠代理才能出网」时，才设为 1 强制走系统代理：
# VR_DATA_PROXY=1

# AI：无需在此配置。用户在网页「接入 AI」页填自己的 key（存本地浏览器），
#     或用订阅接入调本机已登录的 CLI（Claude Code / Codex / Qwen / Gemini / DeepSeek）。
